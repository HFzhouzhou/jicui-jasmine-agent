# Copy to .env. Never commit the real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_MS=30000
# Development API. Vite proxies /api to this port.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Default: do not trust forwarded IPs. Configure only for your actual reverse proxy.
# Examples: loopback (native local proxy), 1 (exactly one controlled proxy hop).
TRUST_PROXY=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# At least 24 characters. Empty = administration disabled. Paste only into the admin login form.
ADMIN_TOKEN=
# Docker host port, normally accessed through your HTTPS reverse proxy.
APP_PORT=3001
# Optional hybrid retrieval. Leave all blank to use local Chinese full-text retrieval.
# Only configure a provider you authorize to receive indexed document excerpts.
# Independent OpenAI-compatible embeddings endpoint; NOT the DeepSeek chat endpoint.
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_TIMEOUT_MS=8000
