{
  "name": "jicui-jasmine-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "lint": "eslint src server tests",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "precommit": "npm run typecheck && npm run lint",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
